# Copy to backend/.env to override defaults. Never commit the real .env.
# Every value is optional for local development.

# SQLAlchemy database URL. Default: SQLite file at backend/stocksense.db
# DATABASE_URL=sqlite:///C:/absolute/path/to/stocksense.db

# Secret used to sign login tokens. REQUIRED for any shared/deployed instance.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Login session length in minutes (default 720 = 12 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Password-reset OTP settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# No email/SMS provider is wired up yet. With OTP_DEV_MODE=true the code is shown
# on the Forgot Password screen and printed in the server log. Only set this to
# false after plugging a real sender into services/auth_service.py:deliver_otp.
OTP_DEV_MODE=true

# Allowed browser origins. Only needed when the frontend calls the API directly
# (the Vite dev server proxies /api, so local development works without this).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Load demo data on startup when the database has no users
AUTO_SEED=true
