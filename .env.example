# Frontend (Vite) settings. Copy to .env.local to override; never commit real .env files.

# Base URL the browser uses for API calls. The default "/api" goes through the
# Vite dev/preview proxy below, so no CORS setup is needed locally.
VITE_API_URL=/api

# Where the Vite dev/preview server forwards /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
